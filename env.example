# ============================================================
#  환경 변수 설정 - 실제 값으로 교체하세요
# ============================================================

# Groq API 키 (https://console.groq.com 에서 발급)
GROQ_API_KEY=your_groq_api_key_here

# 사용할 Groq 모델 (기본: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# 방어 임계값 (0.0~1.0, 낮을수록 엄격)
DEFENSE_BLOCK_THRESHOLD=0.5

# 로그 레벨
LOG_LEVEL=INFO
